[% USE Koha %]
[% USE HTML %]
[% USE KohaDates %]
[% SET footerjs = 1 %]

[% INCLUDE 'doc-head-close.inc' %]

<title>LibraryIQ Configuration</title>

[% BLOCK cssinclude %][% END %]
</head>

<body id="admin_libraryiq_configure" class="admin">

[% INCLUDE 'header.inc' %]
[% INCLUDE 'cat-search.inc' %]

<nav id="breadcrumbs" aria-label="Breadcrumb" class="breadcrumb">
    <ol>
        <li>
            <a href="/cgi-bin/koha/mainpage.pl">Home</a>
        </li>
        <li>
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        </li>
        <li>
            <a href="#">LibraryIQ Configuration</a>
        </li>
    </ol>
</nav>

<div class="main container-fluid">
    <div class="row">
        <div class="col-sm-10 col-sm-push-2">
            <main>
                [% IF (saved) %]
                    <div class="dialog message">
                        <h4>Configuration saved</h4>
                        <p><a href="/cgi-bin/koha/plugins/run.pl?class=Koha::Plugin::Com::ByWaterSolutions::LibraryIQ&method=configure">Return to configuration</a></p>
                    </div>
                [% END %]

                <h1>LibraryIQ Configuration</h1>

                <form method="post" action="/cgi-bin/koha/plugins/run.pl?class=Koha::Plugin::Com::ByWaterSolutions::LibraryIQ&method=configure">
                    <input type="hidden" name="save" value="1" />
                    
                    <fieldset class="rows">
                        <legend>Title Template</legend>
                        <ol>
                            <li>
                                <label for="title_template">Title Template: </label>
                                <input type="text" name="title_template" id="title_template" value="[% title_template | html %]" size="50" />
                                <div class="hint">
                                    Replace the default title as formatted by Koha with a set of MARC fields, separated by commas.
                                    <br/>
                                    Example: <em>245$a,245$b,245$p,245$n</em>
                                </div>
                            </li>
                        </ol>
                    </fieldset>

                    <fieldset class="action">
                        <input type="submit" class="btn btn-primary" value="Save configuration" />
                        <a class="cancel" href="/cgi-bin/koha/plugins/plugins-home.pl">Cancel</a>
                    </fieldset>
                </form>
            </main>
        </div>

        <div class="col-sm-2 col-sm-pull-10">
            <aside>
                [% INCLUDE 'admin-menu.inc' %]
            </aside>
        </div>
    </div>
</div>

[% INCLUDE 'intranet-bottom.inc' %]
